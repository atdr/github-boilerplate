{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "github-boilerplate",
      "include-component-in-tag": false,
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "extra-files": [
        {
          "type": "generic",
          "path": "template/core/.github/workflows/checks.yml"
        },
        {
          "type": "generic",
          "path": "template/core/.github/workflows/pull-request.yml"
        },
        {
          "type": "generic",
          "path": "template/node/.github/workflows/ci.yml"
        },
        {
          "type": "generic",
          "path": "template/python/.github/workflows/ci.yml"
        }
      ]
    }
  }
}
