{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "github-boilerplate",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "extra-files": [
        "template/core/.github/workflows/checks.yml",
        "template/core/.github/workflows/pull-request.yml",
        "template/node/.github/workflows/ci.yml",
        "template/python/.github/workflows/ci.yml"
      ]
    }
  }
}
